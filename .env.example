# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 제출물·저장소에 넣지 않습니다)
# Claude API 키 — 없으면 규칙 기반(입력 양식·고정 문장)으로만 동작합니다.
ANTHROPIC_API_KEY=
# 사용할 모델(기본 claude-opus-5-5). 비용을 줄이려면 claude-haiku-5-5 또는 claude-sonnet-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# Claude 사용 끄기: off
IMPACT_LLM=on
# 안전 분류기 거절 시 서버가 다른 Claude 모델로 다시 실행(Opus·Sonnet 5.5): off 로 끔
IMPACT_LLM_FALLBACK=on
# 결과 보관(on 이면 work 폴더를 지우지 않음). 센터 운영 기본은 off
IMPACT_KEEP_RESULTS=off
